head
  meta(charset="utf-8")
  meta(name="viewport", content="width=device-width, initial-scale=1")
  title= title
  link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
  link(rel="preconnect", href="https://fonts.googleapis.com")
  link(href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap", rel="stylesheet")
  style.
    body { background:#f7f8f5;color:#202820;font-family:'DM Sans',sans-serif; }
    h1,h2,h3 {font-family:'Manrope',sans-serif;letter-spacing:-.035em}
    .navbar-brand {font-family:'Manrope',sans-serif;letter-spacing:-.04em}
    .card {border:1px solid #edf0e9;border-radius:16px;box-shadow:0 4px 20px #26342108}
    .btn-success {--bs-btn-bg:#557b50;--bs-btn-border-color:#557b50;--bs-btn-hover-bg:#436640}
    .text-success {color:#557b50!important}
    .badge-soft {background:#edf3e8;color:#557b50}
    .page-wrap {max-width:1440px}
