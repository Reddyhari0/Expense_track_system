doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= title
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap", rel="stylesheet")
    style.
      :root { --ink:#202820; --muted:#758075; --green:#557b50; --cream:#f7f8f2; }
      body { font-family:'DM Sans',sans-serif; color:var(--ink); background:#fff; }
      h1,h2,h3,.brand { font-family:'Manrope',sans-serif; letter-spacing:-.04em; }
      .navbar { background:#fff; }
      .brand-mark { display:inline-grid;place-items:center;background:#557b50;color:#fff;width:34px;height:34px;border-radius:11px;font-weight:800;margin-right:9px; }
      .hero { background:var(--cream); min-height:620px; display:flex;align-items:center; overflow:hidden; }
      .hero-title { font-size:clamp(3.3rem,7vw,6.2rem);line-height:.99;max-width:750px; }
      .hero-title span { color:var(--green); }
      .eyebrow { color:var(--green);font-size:.78rem;letter-spacing:.14em;font-weight:700;text-transform:uppercase; }
      .hero-card { background:#fff;border-radius:24px;padding:30px;box-shadow:0 28px 70px #29372516; transform:rotate(2deg); }
      .ring { width:145px;height:145px;border:17px solid #e5eddf;border-top-color:#557b50;border-right-color:#a5c18d;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:1.35rem; }
      .soft-section { background:#f7f8f2; }
      .feature-card { background:#fff;border:1px solid #eef0e9;border-radius:18px;padding:27px;height:100%; }
      .icon-box { width:44px;height:44px;display:grid;place-items:center;background:#edf3e8;color:var(--green);border-radius:14px;font-size:1.2rem; }
      .btn-success { --bs-btn-bg:#557b50;--bs-btn-border-color:#557b50;--bs-btn-hover-bg:#436640; }
      .section-pad { padding:100px 0; }
  body
    nav.navbar.navbar-expand-lg.sticky-top.border-bottom
      .container.py-2
        a.navbar-brand.brand.fw-bold(href="/")
          span.brand-mark P
          | pennywise
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#nav")
          span.navbar-toggler-icon
        #nav.collapse.navbar-collapse
          ul.navbar-nav.mx-auto.gap-lg-3
            li.nav-item: a.nav-link(href="#about") About
            li.nav-item: a.nav-link(href="#features") What you get
            li.nav-item: a.nav-link(href="#contact") Contact
          .d-flex.gap-2
            a.btn.btn-link.text-dark.text-decoration-none(href="/login") Sign in
            a.btn.btn-success.rounded-pill.px-4(href="/register") Get started
    main
      section.hero
        .container.py-5
          .row.align-items-center.g-5
            .col-lg-7
              p.eyebrow A calmer way to manage money
              h1.hero-title Your money, #[span in good shape.]
              p.lead.text-secondary.my-4(style="max-width:560px") A simple view of your spending, budgets and everyday choices. Make room for what matters.
              .d-flex.flex-wrap.gap-3
                a.btn.btn-success.btn-lg.rounded-pill.px-4(href="/dashboard") Explore dashboard
                a.btn.btn-outline-secondary.btn-lg.rounded-pill.px-4(href="#about") Meet Pennywise
              p.small.text-secondary.mt-4 Your spending, organized into one clear picture.
            .col-lg-5
              .hero-card
                .d-flex.justify-content-between.align-items-start
                  div
                    p.small.text-secondary.mb-1 THIS MONTH
                    h3.mb-0 Spending snapshot
                  span.icon-box ↗
                .d-flex.align-items-center.justify-content-center.gap-4.py-4
                  .ring 68%
                  div
                    p.small.text-secondary.mb-1 Budget used
                    h4.fw-bold.mb-1 £2,468.00
                    span.small.text-success ● 8% under last month
                .d-flex.justify-content-between.border-top.pt-3
                  span.small.text-secondary Daily average
                  span.fw-semibold £82.27
      section#about.section-pad
        .container
          .row.align-items-center.g-5
            .col-lg-5
              p.eyebrow About us
              h2.display-5.fw-bold A little more clarity goes a long way.
            .col-lg-6.offset-lg-1
              p.fs-5.text-secondary Pennywise helps you see where your money goes without making money management feel like a chore. We bring expenses, categories and monthly budgets into one clear view.
              p.text-secondary Our goal is to make everyday financial decisions feel simpler, more thoughtful and easier to keep up with.
      section#features.soft-section.section-pad
        .container
          .text-center.mb-5
            p.eyebrow Made for everyday life
            h2.display-6.fw-bold A clearer picture, at a glance
          .row.g-4
            .col-md-4
              .feature-card
                .icon-box.mb-4 ◷
                h4 See your spending
                p.text-secondary.mb-0 Browse transactions and spot patterns with useful search and filters.
            .col-md-4
              .feature-card
                .icon-box.mb-4 ◉
                h4 Keep budgets in view
                p.text-secondary.mb-0 Compare category spending with your monthly budget limits.
            .col-md-4
              .feature-card
                .icon-box.mb-4 ↗
                h4 Find the details
                p.text-secondary.mb-0 Open a transaction for its date, payment method and notes.
      section#contact.section-pad
        .container
          .row.align-items-center
            .col-lg-7
              p.eyebrow Contact us
              h2.display-6.fw-bold Have a question? We’re listening.
              p.text-secondary.mb-0 Tell us what would make managing your money easier.
            .col-lg-5.text-lg-end.mt-4.mt-lg-0
              a.btn.btn-success.rounded-pill.px-4(href="mailto:hello@pennywise.example") hello@pennywise.example
    footer.border-top.py-4
      .container.d-flex.flex-wrap.justify-content-between.gap-2.small.text-secondary
        span © 2026 Pennywise. Built for a clearer view.
        a.text-secondary(href="/dashboard") Go to your dashboard
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
