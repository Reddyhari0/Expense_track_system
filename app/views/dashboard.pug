doctype html
html(lang="en")
  include _head.pug
  body
    include _nav.pug
    main.container-fluid.px-3.px-lg-4.py-4(style="max-width:1440px")
      .d-flex.flex-wrap.justify-content-between.align-items-end.gap-3.mb-4
        div
          p.text-success.text-uppercase.small.fw-bold.mb-1 Your finances, at a glance
          h1.fw-bold.mb-1 Dashboard
          p.text-secondary.mb-0 Track spending and understand your habits.
      .row.g-3.mb-4
        .col-sm-6.col-xl-6
          .card.h-100: .card-body.p-4
            p.small.text-secondary.mb-2 Total spending
            h3.fw-bold.mb-0 £#{Number(totals.spent).toLocaleString('en-GB', {minimumFractionDigits:2,maximumFractionDigits:2})}
        .col-sm-6.col-xl-6
          .card.h-100: .card-body.p-4
            p.small.text-secondary.mb-2 Transactions
            h3.fw-bold.mb-0= totals.count
      .card
        .card-body.p-4
          h4.fw-bold.mb-3 Transactions
          if expenses.length
            .table-responsive
              table.table.align-middle
                thead: tr
                  th Expense
                  th Category
                  th Date
                  th.text-end Amount
                tbody
                  each expense in expenses
                    tr
                      td
                        span.fw-semibold= expense.title
                        div.small.text-secondary= expense.full_name
                      td
                        span.badge.rounded-pill(style='background-color:' + expense.color + '20;color:' + expense.color)= expense.category
                      td.text-secondary= new Date(expense.spent_on).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})
                      td.text-end.fw-semibold £#{Number(expense.amount).toLocaleString('en-GB', {minimumFractionDigits:2,maximumFractionDigits:2})}
          else
            .text-center.py-5
              h5 No expenses yet
              p.text-secondary.mb-0 Your transactions will appear here.
    include _scripts.pug
