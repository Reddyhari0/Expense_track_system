doctype html
html(lang="en")
  include _head.pug
  body
    include _nav.pug
    main.container-fluid.px-3.px-lg-4.py-4(style="max-width:1440px")
      .d-flex.flex-wrap.justify-content-between.align-items-end.gap-3.mb-4
        div
          p.text-success.text-uppercase.small.fw-bold.mb-1 Your finances, at a glance
          h1.fw-bold.mb-1 Dashboard
          p.text-secondary.mb-0 Track spending and understand your habits.
      .row.g-3.mb-4
        .col-sm-6.col-xl-6
          .card.h-100: .card-body.p-4
            p.small.text-secondary.mb-2 Total spending
            h3.fw-bold.mb-0 £#{Number(totals.spent).toLocaleString('en-GB', {minimumFractionDigits:2,maximumFractionDigits:2})}
        .col-sm-6.col-xl-6
          .card.h-100: .card-body.p-4
            p.small.text-secondary.mb-2 Transactions
            h3.fw-bold.mb-0= totals.count
      .card
        .card-body.p-4
          .d-flex.justify-content-between.align-items-center.mb-3
            h4.fw-bold.mb-0 Transactions
            span.badge.rounded-pill.badge-soft= expenses.length + ' results'
          form.row.g-2.align-items-end.mb-4(method="get", action="/dashboard")
            .col-lg-3.col-sm-6
              label.form-label.small(for="search") Search
              input#search.form-control(type="search", name="search", value=filters.search, placeholder="Title, category…")
            .col-lg-2.col-sm-6
              label.form-label.small(for="category") Category
              select#category.form-select(name="category")
                option(value="") All categories
                each item in categories
                  option(value=item.id, selected=String(filters.category) === String(item.id))= item.name
            .col-lg-2.col-sm-6
              label.form-label.small(for="from") From
              input#from.form-control(type="date", name="from", value=filters.from)
            .col-lg-2.col-sm-6
              label.form-label.small(for="to") To
              input#to.form-control(type="date", name="to", value=filters.to)
            .col-lg-1.col-sm-6
              label.form-label.small(for="min") Min £
              input#min.form-control(type="number", name="min", min="0", step="0.01", value=filters.min)
            .col-lg-1.col-sm-6
              label.form-label.small(for="max") Max £
              input#max.form-control(type="number", name="max", min="0", step="0.01", value=filters.max)
            .col-lg-1.d-grid
              button.btn.btn-success(type="submit") Go
            .col-12
              a.small.text-secondary(href="/dashboard") Clear filters
          if expenses.length
            .table-responsive
              table.table.align-middle
                thead: tr
                  th Expense
                  th Category
                  th Date
                  th.text-end Amount
                tbody
                  each expense in expenses
                    tr
                      td
                        span.fw-semibold= expense.title
                        div.small.text-secondary= expense.full_name
                      td
                        span.badge.rounded-pill(style='background-color:' + expense.color + '20;color:' + expense.color)= expense.category
                      td.text-secondary= new Date(expense.spent_on).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})
                      td.text-end.fw-semibold £#{Number(expense.amount).toLocaleString('en-GB', {minimumFractionDigits:2,maximumFractionDigits:2})}
          else
            .text-center.py-5
              h5 No expenses yet
              p.text-secondary.mb-0 Your transactions will appear here.
    include _scripts.pug
